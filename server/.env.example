# ====================================================================
# Test Grievance Management System - Environment Variables Configuration
# ====================================================================

# Port for local backend Express server
PORT=5000

# --------------------------------------------------------------------
# OPTION 1: Aiven.io Cloud MySQL (RECOMMENDED for Vercel Deployment)
# --------------------------------------------------------------------
# You can connect using EITHER the single Service URI OR individual variables:

# Method A: Full Service URI (Copy directly from Aiven Console -> "Service URI")
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-xxxx-yourproject.aivencloud.com:21345/defaultdb?ssl-mode=REQUIRED

# Method B: Individual parameters from Aiven Dashboard Overview
# DB_HOST=mysql-xxxx-yourproject.aivencloud.com
# DB_PORT=21345
# DB_USER=avnadmin
# DB_PASSWORD=YOUR_AIVEN_PASSWORD
# DB_NAME=defaultdb
# DB_SSL=true

# --------------------------------------------------------------------
# OPTION 2: Local MySQL Database (For Local Development)
# --------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=test_grievance_db
DB_SSL=false
